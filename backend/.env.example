NODE_ENV=development
PORT=3000
# In development, if PORT is busy the server tries 3001, 3002, … and writes backend/.dev-server-port
# Local install example (adjust user/password to match your PostgreSQL)
DATABASE_URL=postgresql://postgres:1234@localhost:5432/ethiojobs?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=5242880
EMPLOYER_SELF_POSTING=false
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Same Web client ID as VITE_GOOGLE_CLIENT_ID. Authorized origin: http://localhost:5173
GOOGLE_CLIENT_ID=
